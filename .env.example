DB_PATH=data/meterhouse.duckdb
SEED=20261112
BIZ_TZ_OFFSET=8
USE_SEMANTIC_LAYER=0

# 审计导出：任务、快照与交付物根目录
AUDIT_ROOT=data/audit
# 快照 TTL（秒），过期后任务显式失败，需重新发起
AUDIT_SNAPSHOT_TTL_SECONDS=86400
# 分段目标行数与单批读取行数（后者决定导出侧内存上限）
AUDIT_SEGMENT_SIZE=5000
AUDIT_FETCH_BATCH_SIZE=1000
AUDIT_MAX_RETRIES=3
AUDIT_HEARTBEAT_SECONDS=5
# 导出专用连接的资源上限，与交互查询隔离
AUDIT_DUCKDB_MEMORY_LIMIT=256MB
AUDIT_DUCKDB_THREADS=1
