# ---- 本地引擎（DuckDB）----
DB_PATH=data/meterhouse.duckdb
SEED=20261112

# 业务时区。指标定义里可按指标覆盖；这里是默认值。
BIZ_TZ=Asia/Shanghai
# 仅旧的 ground_truth() 调用方使用
BIZ_TZ_OFFSET=8

# ---- 指标与切流 ----
METRICS_FILE=metrics/metrics.yaml
MH_CUTOVER_FILE=metrics/routes.yaml
# 设置后，所有写操作（切流、同步）必须带 X-Admin-Token 头。
# 留空时仅允许本机演示使用，响应里 actor 标为 local-unauthenticated。
MH_ADMIN_TOKEN=

# ---- 列式引擎（ClickHouse）----
# 不设置 CLICKHOUSE_HOST 时，ClickHouse 路由不可用：
# 接口只能保持 mode=off，切到 primary 会被拒绝。
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=meterhouse
CLICKHOUSE_TIMEOUT_S=3

# ---- 容量 ----
MH_DUCKDB_MAX_CONCURRENCY=8
MH_CLICKHOUSE_MAX_CONCURRENCY=16
MH_MAX_RESULT_ROWS=50000
MH_ACQUIRE_TIMEOUT_S=2.0
